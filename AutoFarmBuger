                        t.Parent = char
                        break
                    end
                end
            end
        end

        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then continue end
        for _, v in ipairs(pg:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                if string.find(string.lower(v.Text or ""), "play again") then
                    local btn = v:IsA("TextButton") and v or v.Parent
                    if btn and btn:IsA("GuiButton") and btn.Visible then
                        pcall(function()
                            if getconnections then
                                for _, e in ipairs(getconnections(btn.Activated)) do e:Fire() end
                                for _, e in ipairs(getconnections(btn.MouseButton1Click)) do e:Fire() end
                                for _, e in ipairs(getconnections(btn.MouseButton1Down)) do e:Fire() end
                            end
                            if firesignal then
                                firesignal(btn.Activated)
                                firesignal(btn.MouseButton1Click)
                                firesignal(btn.MouseButton1Down)
                            end
                            local absPos = btn.AbsolutePosition
                            local absSize = btn.AbsoluteSize
                            local inset = GuiService:GetGuiInset()
                            local cx = absPos.X + absSize.X / 2
                            local cy = absPos.Y + absSize.Y / 2 + inset.Y
                            if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
                                VirtualInputManager:SendTouchEvent(cx, cy, true)
                                task.wait(0.1)
                                VirtualInputManager:SendTouchEvent(cx, cy, false)
                            else
                                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                                task.wait(0.1)
                                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                            end
                        end)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if not Config.AutoFarmEnabled then
            hoverPos = nil
            continue
        end

        local char = LocalPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end

        if autoFarmStartTime > 0 and tick() - autoFarmStartTime >= Config.AutoResetMinutes * 60 then
            pcall(function()
                local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                for _ = 1, 3 do
                    Remotes.Reset.fireServer()
                    task.wait(1)
                end
            end)
            hoverPos = nil
            visited = false
            engaged = false
            visitedSkyIsland = false
            currentIdx = 1
            autoFarmStartTime = tick()
            continue
        end

        if hum.Health <= 0 then
            hoverPos = nil
            visited = false
            engaged = false
            visitedSkyIsland = false
            currentIdx = 1
            task.wait(1)
            continue
        end

        if currentIdx <= #bosses then
            local info = bosses[currentIdx]
            local targetBoss = cachedBosses[info.n]

            if targetBoss then
                local bHrp = targetBoss:FindFirstChild("HumanoidRootPart")
                local bHum = targetBoss:FindFirstChildOfClass("Humanoid")

                if bHrp and bHum and bHum.Health > 0 then
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    engaged = true
                    bHrp.CFrame = CFrame.new(info.pos.Position)
                    bHrp.Velocity = Vector3.new(0, 0, 0)
                    hoverPos = CFrame.lookAt(info.pos.Position + Vector3.new(0, 15, 0), info.pos.Position)
                elseif bHum and bHum.Health <= 0 then
                    task.wait(3)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                end
            else
                if engaged then
                    task.wait(3)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                else
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    hoverPos = CFrame.new(info.pos.Position + Vector3.new(0, 15, 0))
                end
            end
        else
            if not visitedSkyIsland then
                hoverPos = nil
                hrp.CFrame = skyIslandPos
                hrp.Anchored = true
                task.wait(2)
                hrp.Anchored = false
                visitedSkyIsland = true
                hoverPos = skyIslandPos
            end

            if #itemQueue == 0 and currentTarget == nil then
                task.wait(3)
                if #itemQueue == 0 and currentTarget == nil then
                    hoverPos = nil
                    visitedSkyIsland = false
                    currentIdx = 1
                    autoFarmStartTime = tick()
                    task.spawn(function()
                        pcall(function()
                            local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                            Remotes.Reset.fireServer()
                        end)
                    end)
                end
            end
        end
    end
end)

