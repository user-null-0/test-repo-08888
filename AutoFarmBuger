                if not tool or not isMelee(tool) then
                    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if t:IsA("Tool") and isMelee(t) then
                            t.Parent = char
                            break
                        end
                    end
                end
                activateHeldTool()
            end
        end
    end
end)

local targetItems = { ["Burger"] = true, ["GoldenBurger"] = true, ["DiamondBurger"] = true }
local itemQueue = {}
local currentTarget = nil
local processTimer = 0

local function addToQueue(obj)
    if targetItems[obj.Name] then
        for _, v in ipairs(itemQueue) do if v == obj then return end end
        table.insert(itemQueue, obj)
    end
end

for _, obj in ipairs(workspace:GetDescendants()) do addToQueue(obj) end
workspace.DescendantAdded:Connect(addToQueue)

RunService.RenderStepped:Connect(function(deltaTime)
    if not Config.BringBurger then return end

    if not targetItems[currentTarget and currentTarget.Name or ""] or not currentTarget.Parent then
        if #itemQueue > 0 then
            currentTarget = table.remove(itemQueue, 1)
            processTimer = 0
        else
            currentTarget = nil
        end
    end

    if currentTarget then
        local targetCFrame = Camera.CFrame * CFrame.new(0, 0, -2.5)

        if currentTarget:IsA("Model") then
            currentTarget:PivotTo(targetCFrame)
        elseif currentTarget:IsA("BasePart") then
            currentTarget.CFrame = targetCFrame
        end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

        processTimer = processTimer + deltaTime
        if processTimer > 0.2 then
            currentTarget = nil
            processTimer = 0
        end
    end
end)

local cachedBosses = {}
local bossTargets = {
    mastersamurai = true,
    eldervampire = true,
    gnomechampion = true,
    steamborneczar = true,
    kingice = true,
}

local function getBossKey(model)
    local name = string.gsub(string.lower(model.Name), "%s+", "")
    for n in pairs(bossTargets) do
        if string.find(name, n) then return n end
    end
    return nil
end

local function registerBoss(v)
    local key = getBossKey(v)
    if not key then return end
    local hum = v:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        cachedBosses[key] = v
        hum.Died:Connect(function()
            if cachedBosses[key] == v then cachedBosses[key] = nil end
        end)
    end
end

for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("Model") then registerBoss(v) end
end

workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Model") then registerBoss(v) end
end)

workspace.DescendantRemoving:Connect(function(v)
    if not v:IsA("Model") then return end
    local key = getBossKey(v)
    if key and cachedBosses[key] == v then cachedBosses[key] = nil end
end)

