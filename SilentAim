local function CreateFloatButton(name, text, defaultPos)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 50, 0, 50)
    btn.Position = defaultPos
    btn.BackgroundColor3 = Color3.fromRGB(62, 62, 62)
    btn.BackgroundTransparency = 1 
    btn.AutoButtonColor = false 
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Visible = false
    btn.Parent = FloatGui

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0.25, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.6
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local grad = Instance.new("UIGradient", stroke)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(60, 0, 120)),   
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 100, 200)),  
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(60, 0, 120)),   
    })

    task.spawn(function()
        local tweenInfo = TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        TweenService:Create(grad, tweenInfo, {Rotation = 180}):Play()
    end)

    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging = false
            dragInput = nil
        end
    end)

    return btn
end

