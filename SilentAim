local function IsTargetVisible(targetPart, myChar)
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {myChar, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction, params)
    return not (result and result.Instance and not result.Instance:IsDescendantOf(targetPart.Parent))
end

local FriendCache = {}
local function isFriend(player)
    if not S.Config.FriendCheck then return false end
    local userId = player.UserId
    if FriendCache[userId] ~= nil then return FriendCache[userId] end
    local success, result = pcall(function() return LocalPlayer:IsFriendsWith(userId) end)
    if success then FriendCache[userId] = result return result end
    return false
end

local function GetTargetPart(model)
    if S.Config.AimPart == "Head" then
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    else
        return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
    end
end

-- Tăng tốc độ quét mục tiêu lên 0.03s để bám sát tâm hơn
task.spawn(function()
    while task.wait(0.03) do
        Camera = workspace.CurrentCamera
        local char = LocalPlayer.Character
        isHoldingGun = char and char:FindFirstChildOfClass("Tool") ~= nil
        local canAim = S.Config.NoToolCheck or isHoldingGun
        local target = nil
        
        if canAim and char and char:FindFirstChild("HumanoidRootPart") and Camera then
            local myPos = char.HumanoidRootPart.Position
            local shortestDist = S.Config.AimMode == "FOV" and S.Config.FOVRadius or math.huge
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local potentialTargets = {}
            
            if S.Config.AimPlayer then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        if S.Config.TeamCheck and p.Team == LocalPlayer.Team then continue end
                        if S.Config.FriendCheck and isFriend(p) then continue end
                        table.insert(potentialTargets, p.Character)
                    end
                end
            end
            
            if S.Config.AimNPC then
                for i = #NPCCache, 1, -1 do
                    if NPCCache[i] and NPCCache[i].Parent then 
                        table.insert(potentialTargets, NPCCache[i])
                    else 
                        table.remove(NPCCache, i) 
                    end
                end
            end
            
            for _, obj in ipairs(potentialTargets) do
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local part = GetTargetPart(obj)
                if hum and hum.Health > 0 and part then
                    if S.Config.WallCheck and not IsTargetVisible(part, char) then continue end
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        if S.Config.AimMode == "FOV" then
                            local distToCenter = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if distToCenter <= shortestDist then 
                                target = part 
                                shortestDist = distToCenter 
                            end
                        else
                            local dist3D = (part.Position - myPos).Magnitude
                            if dist3D < shortestDist then 
                                target = part 
                                shortestDist = dist3D 
                            end
                        end
                    end
                end
            end
        end
        currentTarget = target
    end
end)

-- HÀM KIỂM TRA ĐIỀU KIỆN SILENT AIM
local function CanSilentAim()
    if not (S.Config.AimPlayer or S.Config.AimNPC) then return false end
    if not currentTarget or not currentTarget.Parent then return false end
    if S.Config.ClickToAim and not S.Config.IsTapping then return false end
    if not S.Config.NoToolCheck and not isHoldingGun then return false end
    return true
end

local function GetPredictedPos()
    local pos = currentTarget.Position
    if S.Config.Prediction then
        local vel = currentTarget.AssemblyLinearVelocity
        if vel then
            pos = pos + (vel * S.Config.PredictionFactor)
        end
    end
    return pos
end

-- HỆ THỐNG HOOK UNIVERSAL MỚI (HỖ TRỢ MỌI GAME SAU UPDATE)
local isNamecallHooked = false
local oldNamecall
local oldIndex
local oldRaycast

function InitSilentAimHook()
    if isNamecallHooked then return end
    isNamecallHooked = true

    -- 1. Hook trực tiếp hàm workspace.Raycast (chống Luau Fastcall)
    if hookfunction and workspace.Raycast then
        oldRaycast = hookfunction(workspace.Raycast, newcclosure(function(self, origin, direction, params)
            if not checkcaller() and self == workspace and CanSilentAim() then
                if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude > 5 then
                    local targetPos = GetPredictedPos()
                    direction = (targetPos - origin).Unit * direction.Magnitude
                end
            end
            return oldRaycast(self, origin, direction, params)
        end))
    end

    -- 2. Hook __namecall (Raycast, FindPartOnRay, Spherecast, Blockcast)
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if not checkcaller() and self == workspace and CanSilentAim() then
            local method = getnamecallmethod()
            local args = table.pack(...)
            local targetPos = GetPredictedPos()

            if (method == "Raycast" or method == "raycast") and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                if args[2].Magnitude > 5 then
                    args[2] = (targetPos - args[1]).Unit * args[2].Magnitude
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
            elseif (method == "FindPartOnRayWithIgnoreList" or method == "findPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay" or method == "findPartOnRay") and typeof(args[1]) == "Ray" then
                local origRay = args[1]
                if origRay.Direction.Magnitude > 5 then
                    args[1] = Ray.new(origRay.Origin, (targetPos - origRay.Origin).Unit * origRay.Direction.Magnitude)
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
            elseif (method == "Spherecast" or method == "spherecast") and typeof(args[1]) == "Vector3" and typeof(args[3]) == "Vector3" then
                if args[3].Magnitude > 5 then
                    args[3] = (targetPos - args[1]).Unit * args[3].Magnitude
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
            elseif (method == "Blockcast" or method == "blockcast") and typeof(args[1]) == "CFrame" and typeof(args[3]) == "Vector3" then
                if args[3].Magnitude > 5 then
                    args[3] = (targetPos - args[1].Position).Unit * args[3].Magnitude
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
            end
        end
        return oldNamecall(self, ...)
    end))

    -- 3. Hook __index cho các game dùng Mouse.Hit / Mouse.Target / Mouse.UnitRay
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not checkcaller() and self == Mouse and CanSilentAim() then
            local k = string.lower(tostring(key))
            local targetPos = GetPredictedPos()
            if k == "hit" then
                return CFrame.new(targetPos)
            elseif k == "target" then
                return currentTarget
            elseif k == "unitray" then
                local origin = Camera.CFrame.Position
                return Ray.new(origin, (targetPos - origin).Unit)
            end
        end
        return oldIndex(self, key)
    end))
end

