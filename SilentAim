local NPCCache = {}
local function AddToCache(obj)
    if obj:IsA("Model") and obj ~= LocalPlayer.Character then
        task.delay(0.2, function()
            if obj and obj.Parent and obj:FindFirstChildOfClass("Humanoid") and (obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")) then
