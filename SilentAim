PlayerTab:CreateToggle({ Name = "Noclip", CurrentValue = false, Callback = function(v) S.Config.NoclipEnabled = v end })

local ExtraTab = Window:CreateTab("Extra", nil)

ExtraTab:CreateToggle({ Name = "Enable Prediction", CurrentValue = false, Callback = function(v) S.Config.Prediction = v end })
ExtraTab:CreateSlider({ Name = "Prediction Factor", Range = {0.05, 0.4}, Increment = 0.01, CurrentValue = 0.15, Callback = function(v) S.Config.PredictionFactor = v end })

ExtraTab:CreateSection("Float Buttons Settings")
ExtraTab:CreateSlider({ 
    Name = "Float Button Size", 
    Range = {40, 150}, 
    Increment = 5, 
    CurrentValue = 50,
    Callback = function(v) 
        AuraBtn.Size = UDim2.new(0, v, 0, v)
        AimNPCBtn.Size = UDim2.new(0, v, 0, v)
    end 
})

ExtraTab:CreateSection("UI Settings")
ExtraTab:CreateButton({ Name = "Destroy UI", Callback = function() 
    fovGui:Destroy() 
    FloatGui:Destroy() 
    Rayfield:Destroy() 
end })

UserInputService.InputBegan:Connect(function(i, p) if not p and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then S.Config.IsTapping = true end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then S.Config.IsTapping = false end end)
